rules_version = '2';

// ============================================================================
//  REGLAS DE FIRESTORE  —  SIN PUBLICAR. PROBAR ANTES EN EL SIMULADOR.
// ============================================================================
//
//  POR QUÉ EXISTE ESTE ARCHIVO
//
//  El 10-09-2026 se comprobó que la base se podía leer SIN iniciar sesión:
//  clientes con RIF y teléfono, órdenes con montos. La configuración de
//  Firebase va en el JavaScript público de la web —eso es normal—; lo que
//  faltaba eran reglas.
//
//  LO QUE PASÓ CON LA PRIMERA VERSIÓN
//
//  Se publicó y dejó a una cuenta ADMIN con su perfil correcto sin acceso a
//  nada salvo su propio perfil. Se volvió a la versión anterior. Pasó la regla
//  que compara `request.auth.uid == uid` y falló todo lo que dependía de una
//  función auxiliar que construía la ruta del perfil.
//
//  Esta versión no usa funciones auxiliares para las rutas: cada condición
//  lleva la ruta entera, igual que el ejemplo oficial de Firebase. Aun así,
//  NO SE PUBLICA SIN PASAR ANTES EL SIMULADOR (Reglas → Simulador), con estos
//  tres casos y exactamente estos resultados:
//
//    1. get  /clientes/prueba     con sesión (tu UID)   →  PERMITIDO
//    2. get  /clientes/prueba     sin sesión            →  DENEGADO
//    3. get  /admin_codes/prueba  sin sesión            →  PERMITIDO
//
//  Si alguno sale distinto, no se publica.
//
//  QUÉ HACEN
//
//  - Ver o tocar cualquier dato exige una cuenta APROBADA (usuarios/{uid}
//    con isActive == true). No basta con estar logueado: quien cree una cuenta
//    directamente contra Firebase se saltaría la comprobación del login.
//  - Sin sesión solo se puede comprobar UN código de invitación por su nombre
//    exacto (el registro lo lee antes de crear la cuenta). No se pueden listar.
//  - Nadie se aprueba ni se asciende a sí mismo.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------ usuarios
    match /usuarios/{uid} {
      allow read: if request.auth != null
                  && (request.auth.uid == uid
                      || get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isActive == true);

      // Alta: solo el propio perfil, naciendo en espera y sin privilegios.
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.isActive == false
                    && request.resource.data.rol == 'EMPLEADO';

      // Un ADMIN activo cambia a cualquiera.
      allow update, delete: if request.auth != null
                    && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isActive == true
                    && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'ADMIN';

      // Cada quien edita lo suyo (foto, colores, correo), sin tocar su rol ni
      // su aprobación. updateDoc conserva los campos que no se mandan, así
      // que rol e isActive llegan iguales.
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && resource.data.isActive == true
                    && request.resource.data.isActive == resource.data.isActive
                    && request.resource.data.get('rol', '') == resource.data.get('rol', '');
    }

    // ------------------------------------------------------ admin_codes
    match /admin_codes/{codigo} {
      // Un código concreto, sin sesión. `get` no incluye `list`.
      allow get: if true;

      // El recién registrado marca como usado el código que acaba de gastar.
      allow update: if request.auth != null
                    && resource.data.get('used', false) != true
                    && request.resource.data.used == true
                    && request.resource.data.usedBy == request.auth.uid;

      allow list, create, update, delete: if request.auth != null
                    && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isActive == true
                    && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'ADMIN';
    }

    // --------------------------------------------------- todo lo demás
    // usuarios y admin_codes quedan fuera: si entraran aquí, cualquier
    // empleado activo podría darse el rol de ADMIN.
    match /{coleccion}/{documento=**} {
      allow read, write: if request.auth != null
                         && coleccion != 'usuarios'
                         && coleccion != 'admin_codes'
                         && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isActive == true;
    }
  }
}
