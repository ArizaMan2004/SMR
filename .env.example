# ============================================================
#  PLANTILLA DE CONFIGURACIÓN
# ============================================================
#
#  Todo lo que distingue una instalación de otra está aquí: la base de datos,
#  las llaves y el nombre de la empresa. Ni una sola línea de código cambia
#  entre un taller y otro.
#
#  PARA MONTAR UNA COPIA:
#
#    1. Copia el proyecto entero a otra carpeta.
#    2. Copia este archivo a `.env.local` en esa carpeta.
#    3. Rellena los valores de abajo con los de la nueva empresa.
#    4. npm install && npm run dev
#
#  `.env.local` NO se sube al repositorio (está en .gitignore). Cada copia
#  tiene el suyo, y por eso las dos instalaciones nunca se pisan los datos.
#
#  Las que empiezan por NEXT_PUBLIC_ se envían al navegador. No pongas ahí
#  nada que deba quedarse en el servidor.

# ------------------------------------------------------------
#  NOMBRE DE LA EMPRESA
# ------------------------------------------------------------
#  Sale en la pestaña del navegador, el login, el menú, los códigos de
#  invitación, los nombres de archivo que se descargan y los avisos de
#  Telegram. Cambiarlo aquí lo cambia en todos esos sitios a la vez.

# El nombre completo, tal cual quieres leerlo.
NEXT_PUBLIC_MARCA_NOMBRE=SMR Lase Print

# El corto, para donde no cabe el largo. Sin poner nada, se usa la primera
# palabra del nombre.
NEXT_PUBLIC_MARCA_CORTA=SMR

# Lo que acompaña al nombre en el título de la pestaña.
NEXT_PUBLIC_MARCA_DESCRIPCION=Impresión Digital y Corte Láser

# Prefijo para códigos de invitación y nombres de archivo. Sin espacios ni
# acentos: acaba dentro de un nombre de PNG y de un código que se teclea.
NEXT_PUBLIC_MARCA_CLAVE=SMR

# El logo para fondos oscuros, que es el que sale en la portada y en el pie.
# Pon el archivo en `public/` y su ruta aquí. Vacío, se usa la inicial del
# nombre dentro de un cuadrado.
NEXT_PUBLIC_MARCA_LOGO=/smr-logo-dark.png

# ------------------------------------------------------------
#  FIREBASE  —  la base de datos y las cuentas
# ------------------------------------------------------------
#  Una copia necesita SU PROPIO proyecto de Firebase. Si dos instalaciones
#  comparten estos valores, comparten órdenes, clientes y usuarios: no son dos
#  sistemas, es el mismo abierto dos veces.
#
#  Se sacan de: consola de Firebase → Configuración del proyecto → Tus apps.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ------------------------------------------------------------
#  CLOUDINARY  —  logos, fotos de perfil y comprobantes
# ------------------------------------------------------------
#  Puede ser la misma cuenta para las dos instalaciones —las imágenes no se
#  mezclan porque cada una guarda sus propias URLs— pero con cuentas separadas
#  es más fácil saber qué ocupa qué.

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Estas dos NO llevan NEXT_PUBLIC_: se quedan en el servidor.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------
#  TELEGRAM  —  avisos al taller
# ------------------------------------------------------------
#  Cada instalación necesita SU PROPIO bot: el token manda mensajes como ese
#  bot, y compartirlo haría que los avisos de un taller sonaran en el otro.
#
#  Se saca hablándole a @BotFather en Telegram y mandando /newbot.
#
#  Sin esto los avisos no se mandan y la app lo dice; nada más deja de
#  funcionar.

TELEGRAM_BOT_TOKEN=
