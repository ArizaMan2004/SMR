# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
# ...menos la plantilla. No lleva ni una llave rellena: solo los nombres de
# las variables y para qué sirve cada una. Sin ella, quien clone el repositorio
# para montar otra copia no tiene de dónde partir.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# Configuracion local de Claude Code (rutas absolutas de cada maquina)
.claude/

# Assets de IA: los genera el postinstall copiandolos de node_modules.
# Estaban versionados y son ~35 MB de .wasm que se regeneran solos.
/public/ai-assets/
